# Скопируйте этот файл в .env и заполните:  cp .env.example .env
# Файл .env нельзя выкладывать на GitHub (он уже в .gitignore): в нём секретный токен бота.

# Адрес сайта.
#   example.ru  - Caddy сам получит HTTPS-сертификат (домен должен указывать на IP сервера)
#   :80         - обычный HTTP, например для проверки по IP-адресу сервера
DOMAIN=:80

# Токен Telegram-бота. Его выдаёт @BotFather после команды /newbot.
TELEGRAM_BOT_TOKEN=

# Куда присылать заявки: chat id через запятую (свой, рабочей группы и т.д.).
# Как узнать: запустите сайт с токеном, напишите боту /start, он ответит вашим chat id.
TELEGRAM_CHAT_IDS=

# Необязательно:
# Сколько заявок можно отправить с одного IP за период (защита от спама)
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=1 hour
# Подробность логов: fatal, error, warn, info, debug
LOG_LEVEL=info
